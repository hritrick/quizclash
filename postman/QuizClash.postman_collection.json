    {
      "name": "Quizzes",
      "item": [
        {
          "name": "1. Get All Quizzes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/quizzes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quizzes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Quizzes array returned', function () {",
                  "    pm.expect(json.data.quizzes).to.be.an('array');",
                  "});",
                  "if (json.data.quizzes.length > 0) {",
                  "    pm.environment.set('quizId', json.data.quizzes[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Get Single Quiz By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/quizzes/{{quizId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quizzes",
                "{{quizId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.quiz._id).to.eql(pm.environment.get('quizId'));",
                  "pm.test(\"Public questions hide answer keys\", () => { pm.response.json().data.quiz.questionIds.forEach(q => { pm.expect(q).not.to.have.property(\"correctIndex\"); pm.expect(q).not.to.have.property(\"explanation\"); }); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Create Quiz (Player Rejection - Expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Forbidden Player Quiz\",\n  \"category\": \"General Knowledge\",\n  \"difficulty\": \"easy\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quizzes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quizzes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Player role rejected with 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Create Quiz (Host Success - Expect 201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{hostToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ocean Secrets & Deep Waters\",\n  \"category\": \"Geography\",\n  \"difficulty\": \"medium\",\n  \"questions\": [\n    {\n      \"text\": \"What percentage of Earth's surface is covered by oceans?\",\n      \"options\": [\"51%\", \"61%\", \"71%\", \"81%\"],\n      \"correctIndex\": 2,\n      \"timeLimitSec\": 15,\n      \"points\": 1000,\n      \"explanation\": \"Approximately 71% of Earth's surface is water-covered, with oceans holding 96.5% of all Earth's water.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quizzes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quizzes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Quiz created with 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
