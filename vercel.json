{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "routes": [
    {
      "src": "/api/health",
      "dest": "https://quizclash-06yc.onrender.com/health"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://quizclash-06yc.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
